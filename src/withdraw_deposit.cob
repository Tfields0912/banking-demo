       IDENTIFICATION DIVISION.
       PROGRAM-ID. POST-TRANSACTION.

       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT ACCOUNTS-IN ASSIGN TO "data/accounts.dat"
              ORGANIZATION IS LINE SEQUENTIAL.
           SELECT ACCOUNTS-OUT ASSIGN TO "data/accounts.tmp"
              ORGANIZATION IS LINE SEQUENTIAL.
           SELECT TRANSACTIONS-FILE ASSIGN TO "data/transactions.dat"
              ORGANIZATION IS LINE SEQUENTIAL.

       DATA DIVISION.
       FILE SECTION.
       FD ACCOUNTS-IN.
       01 ACCOUNTS-IN-RECORD PIC X(120).

       FD ACCOUNTS-OUT.
       01 ACCOUNTS-OUT-RECORD PIC X(120).

       FD TRANSACTIONS-FILE.
       01 TRANSACTIONS-RECORD PIC X(160).

       WORKING-STORAGE SECTION.
       01 EOF-FLAG PIC X VALUE "N".
       01 FOUND-FLAG PIC X VALUE "N".
       01 ERROR-FLAG PIC X VALUE "N".

       01 TARGET-ID PIC X(10).
       01 TRANS-TYPE PIC X.
       01 AMOUNT-STR PIC X(20).
       01 AMOUNT-NUM PIC S9(9)V99 VALUE 0.
       01 DESCRIPTION-TEXT PIC X(40).

       01 ACCOUNT-ID PIC X(10).
       01 USER-ID PIC X(10).
       01 BALANCE-STR PIC X(12).
       01 STATUS-STR PIC X(10).
       01 ACCOUNT-TYPE-STR PIC X(10).
       01 CURRENT-BALANCE PIC S9(9)V99 VALUE 0.
       01 NEW-BALANCE PIC S9(9)V99 VALUE 0.

       01 AMOUNT-OUT PIC Z(9)9.99.
       01 NEW-BALANCE-OUT PIC Z(9)9.99.
       01 DISPLAY-BALANCE PIC -Z(9)9.99.

       01 DATE-YYYYMMDD PIC X(8).
       01 TIME-HHMMSSCC PIC X(8).

       01 SYSTEM-COMMAND PIC X(200).
       01 SKIP-FLAG PIC X VALUE "N".

       PROCEDURE DIVISION.
       MAIN.
           DISPLAY "WITHDRAW / DEPOSIT"
           DISPLAY "------------------"
           PERFORM GET-INPUT
           PERFORM VALIDATE-INPUT
           PERFORM SAVE-TRANSACTION
           STOP RUN.

       GET-INPUT.
           DISPLAY "ENTER ACCOUNT ID: " WITH NO ADVANCING
           ACCEPT TARGET-ID
           MOVE FUNCTION TRIM(TARGET-ID) TO TARGET-ID

           DISPLAY "TYPE (D=DEPOSIT, W=WITHDRAW): " WITH NO ADVANCING
           ACCEPT TRANS-TYPE
           MOVE FUNCTION UPPER-CASE(TRANS-TYPE) TO TRANS-TYPE

           DISPLAY "AMOUNT: " WITH NO ADVANCING
           ACCEPT AMOUNT-STR
           MOVE FUNCTION TRIM(AMOUNT-STR) TO AMOUNT-STR

           DISPLAY "DESCRIPTION (OPTIONAL): " WITH NO ADVANCING
           ACCEPT DESCRIPTION-TEXT
           MOVE FUNCTION TRIM(DESCRIPTION-TEXT) TO DESCRIPTION-TEXT.

       VALIDATE-INPUT.
           IF TARGET-ID = SPACES
              DISPLAY "ACCOUNT ID IS REQUIRED."
              STOP RUN
           END-IF

           IF TRANS-TYPE NOT = "D" AND TRANS-TYPE NOT = "W"
              DISPLAY "TYPE MUST BE D OR W."
              STOP RUN
           END-IF

           IF AMOUNT-STR = SPACES
              DISPLAY "AMOUNT IS REQUIRED."
              STOP RUN
           END-IF

           IF FUNCTION TEST-NUMVAL(AMOUNT-STR) NOT = 0
              DISPLAY "AMOUNT MUST BE A NUMBER."
              STOP RUN
           END-IF

           MOVE FUNCTION NUMVAL(AMOUNT-STR) TO AMOUNT-NUM
           IF AMOUNT-NUM <= 0
              DISPLAY "AMOUNT MUST BE GREATER THAN ZERO."
              STOP RUN
           END-IF.

       SAVE-TRANSACTION.
           MOVE "N" TO EOF-FLAG FOUND-FLAG ERROR-FLAG
           OPEN INPUT ACCOUNTS-IN
           OPEN OUTPUT ACCOUNTS-OUT

           PERFORM UNTIL EOF-FLAG = "Y"
           READ ACCOUNTS-IN
           AT END
           MOVE "Y" TO EOF-FLAG
           NOT AT END
           PERFORM PROCESS-ACCOUNT
           END-READ
           END-PERFORM

           CLOSE ACCOUNTS-IN
           CLOSE ACCOUNTS-OUT

           IF FOUND-FLAG NOT = "Y"
              MOVE "rm -f data/accounts.tmp" TO SYSTEM-COMMAND
              CALL "SYSTEM" USING SYSTEM-COMMAND
              DISPLAY "ACCOUNT NOT FOUND."
              STOP RUN
           END-IF

           IF ERROR-FLAG = "Y"
              MOVE "rm -f data/accounts.tmp" TO SYSTEM-COMMAND
              CALL "SYSTEM" USING SYSTEM-COMMAND
              DISPLAY "TRANSACTION FAILED. INSUFFICIENT FUNDS."
              STOP RUN
           END-IF

           MOVE "mv -f data/accounts.tmp data/accounts.dat"
              TO SYSTEM-COMMAND
           CALL "SYSTEM" USING SYSTEM-COMMAND

           OPEN EXTEND TRANSACTIONS-FILE
           ACCEPT DATE-YYYYMMDD FROM DATE YYYYMMDD
           ACCEPT TIME-HHMMSSCC FROM TIME
           MOVE AMOUNT-NUM TO AMOUNT-OUT
           MOVE NEW-BALANCE TO NEW-BALANCE-OUT
           MOVE SPACES TO TRANSACTIONS-RECORD

           STRING
           DATE-YYYYMMDD DELIMITED BY SIZE
           "-" DELIMITED BY SIZE
           TIME-HHMMSSCC(1:6) DELIMITED BY SIZE
           "," DELIMITED BY SIZE
           FUNCTION TRIM(TARGET-ID) DELIMITED BY SIZE
           "," DELIMITED BY SIZE
           TRANS-TYPE DELIMITED BY SIZE
           "," DELIMITED BY SIZE
           FUNCTION TRIM(AMOUNT-OUT) DELIMITED BY SIZE
           "," DELIMITED BY SIZE
           FUNCTION TRIM(NEW-BALANCE-OUT) DELIMITED BY SIZE
           "," DELIMITED BY SIZE
           FUNCTION TRIM(DESCRIPTION-TEXT) DELIMITED BY SIZE
           INTO TRANSACTIONS-RECORD
           END-STRING

           WRITE TRANSACTIONS-RECORD
           CLOSE TRANSACTIONS-FILE

           MOVE NEW-BALANCE TO DISPLAY-BALANCE
           DISPLAY "TRANSACTION SUCCESSFUL. NEW BALANCE: $"
           FUNCTION TRIM(DISPLAY-BALANCE).

       PROCESS-ACCOUNT.
           MOVE SPACES TO ACCOUNT-ID USER-ID BALANCE-STR STATUS-STR
              ACCOUNT-TYPE-STR
           UNSTRING ACCOUNTS-IN-RECORD DELIMITED BY ","
           INTO ACCOUNT-ID USER-ID BALANCE-STR STATUS-STR
              ACCOUNT-TYPE-STR
           END-UNSTRING

           IF FUNCTION TRIM(ACCOUNT-ID) NOT = FUNCTION TRIM(TARGET-ID)
              MOVE ACCOUNTS-IN-RECORD TO ACCOUNTS-OUT-RECORD
              WRITE ACCOUNTS-OUT-RECORD
           ELSE
              MOVE "Y" TO FOUND-FLAG
              PERFORM COMPUTE-NEW-BALANCE
           END-IF.

       COMPUTE-NEW-BALANCE.
           MOVE "N" TO SKIP-FLAG
           MOVE FUNCTION NUMVAL(BALANCE-STR) TO CURRENT-BALANCE

           IF TRANS-TYPE = "D"
              COMPUTE NEW-BALANCE = CURRENT-BALANCE + AMOUNT-NUM
           ELSE
              IF CURRENT-BALANCE < AMOUNT-NUM
                 MOVE "Y" TO ERROR-FLAG
                 MOVE "Y" TO SKIP-FLAG
              ELSE
                 COMPUTE NEW-BALANCE = CURRENT-BALANCE - AMOUNT-NUM
              END-IF
           END-IF

           IF SKIP-FLAG = "Y"
              MOVE ACCOUNTS-IN-RECORD TO ACCOUNTS-OUT-RECORD
              WRITE ACCOUNTS-OUT-RECORD
           ELSE
              MOVE NEW-BALANCE TO NEW-BALANCE-OUT
              MOVE SPACES TO ACCOUNTS-OUT-RECORD
              STRING
              FUNCTION TRIM(ACCOUNT-ID) DELIMITED BY SIZE
              "," DELIMITED BY SIZE
              FUNCTION TRIM(USER-ID) DELIMITED BY SIZE
              "," DELIMITED BY SIZE
              FUNCTION TRIM(NEW-BALANCE-OUT) DELIMITED BY SIZE
              "," DELIMITED BY SIZE
              FUNCTION TRIM(STATUS-STR) DELIMITED BY SIZE
              "," DELIMITED BY SIZE
              FUNCTION TRIM(ACCOUNT-TYPE-STR) DELIMITED BY SIZE
              INTO ACCOUNTS-OUT-RECORD
              END-STRING
              WRITE ACCOUNTS-OUT-RECORD
           END-IF.
