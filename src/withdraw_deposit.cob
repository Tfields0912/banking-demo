       IDENTIFICATION DIVISION.
       PROGRAM-ID. WITHDRAW-DEPOSIT.

       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT ACCOUNTS-IN ASSIGN TO "data/accounts.dat"
              ORGANIZATION IS LINE SEQUENTIAL.
           SELECT ACCOUNTS-OUT ASSIGN TO "data/accounts.tmp"
              ORGANIZATION IS LINE SEQUENTIAL.
           SELECT TRANSACTIONS-FILE ASSIGN TO "data/transactions.dat"
              ORGANIZATION IS LINE SEQUENTIAL.

       DATA DIVISION.
       FILE SECTION.
       FD ACCOUNTS-IN.
       01 ACCOUNTS-IN-RECORD.
           05 AI-ACCOUNT-ID  PIC X(10).
           05 AI-USER-ID     PIC X(10).
           05 AI-BALANCE     PIC 9(9)V99.
           05 AI-STATUS      PIC X(8).
           05 AI-TYPE        PIC X(8).
           05 AI-PAD         PIC X(3).

       FD ACCOUNTS-OUT.
       01 ACCOUNTS-OUT-RECORD.
           05 AO-ACCOUNT-ID  PIC X(10).
           05 AO-USER-ID     PIC X(10).
           05 AO-BALANCE     PIC 9(9)V99.
           05 AO-STATUS      PIC X(8).
           05 AO-TYPE        PIC X(8).
           05 AO-PAD         PIC X(3).

       FD TRANSACTIONS-FILE.
       01 TRANSACTIONS-RECORD.
           05 TR-TIMESTAMP    PIC X(15).
           05 TR-ACCOUNT-ID   PIC X(10).
           05 TR-TYPE         PIC X(1).
           05 TR-AMOUNT       PIC 9(9)V99.
           05 TR-NEW-BALANCE  PIC 9(9)V99.
           05 TR-DESCRIPTION  PIC X(40).
           05 TR-PAD          PIC X(12).

       WORKING-STORAGE SECTION.
       01 CONTROL-FLAGS.
           05 EOF-FLAG PIC X VALUE "N".
           05 FOUND-FLAG PIC X VALUE "N".
           05 ERROR-FLAG PIC X VALUE "N".
           05 INVALID-ENTRY-FLAG PIC X VALUE "N".
           05 CLOSED-ACCOUNT-FLAG PIC X VALUE "N".
           05 SKIP-FLAG PIC X VALUE "N".

       01 INPUT-FIELDS.
           05 TARGET-ID PIC X(10).
           05 TRANS-TYPE PIC X.
           05 AMOUNT-STR PIC X(20).
           05 AMOUNT-NUM PIC S9(9)V99 VALUE 0.
           05 DESCRIPTION-TEXT PIC X(40).

       01 RECORD-FIELDS.
           05 ACCOUNT-ID      PIC X(10).
           05 USER-ID         PIC X(10).
           05 CURRENT-BALANCE PIC S9(9)V99 VALUE 0.
           05 NEW-BALANCE     PIC S9(9)V99 VALUE 0.

       01 OUTPUT-FIELDS.
           05 DISPLAY-BALANCE PIC -Z(9)9.99.

       01 WORK-FIELDS.
           05 DATE-YYYYMMDD PIC X(8).
           05 TIME-HHMMSSCC PIC X(8).

       01 SYSTEM-FIELDS.
           05 SYSTEM-COMMAND PIC X(200).
       

       PROCEDURE DIVISION.
       MAIN.
           DISPLAY "WITHDRAW / DEPOSIT"
           DISPLAY "------------------"
           PERFORM GET-INPUT
           PERFORM VALIDATE-INPUT
           PERFORM SAVE-TRANSACTION
           STOP RUN.

       GET-INPUT.
           DISPLAY "ENTER ACCOUNT ID: " WITH NO ADVANCING
           ACCEPT TARGET-ID
           MOVE FUNCTION TRIM(TARGET-ID) TO TARGET-ID

           DISPLAY "TYPE (D=DEPOSIT, W=WITHDRAW): " WITH NO ADVANCING
           ACCEPT TRANS-TYPE
           MOVE FUNCTION UPPER-CASE(TRANS-TYPE) TO TRANS-TYPE

           DISPLAY "AMOUNT: " WITH NO ADVANCING
           ACCEPT AMOUNT-STR
           MOVE FUNCTION TRIM(AMOUNT-STR) TO AMOUNT-STR

           DISPLAY "DESCRIPTION (OPTIONAL): " WITH NO ADVANCING
           ACCEPT DESCRIPTION-TEXT
           MOVE FUNCTION TRIM(DESCRIPTION-TEXT) TO DESCRIPTION-TEXT.

       VALIDATE-INPUT.
           IF TARGET-ID = SPACES
              DISPLAY "ACCOUNT ID IS REQUIRED."
              STOP RUN
           END-IF

           IF TRANS-TYPE NOT = "D" AND TRANS-TYPE NOT = "W"
              DISPLAY "TYPE MUST BE D OR W."
              STOP RUN
           END-IF

           IF AMOUNT-STR = SPACES
              DISPLAY "AMOUNT IS REQUIRED."
              STOP RUN
           END-IF

           IF FUNCTION TEST-NUMVAL(AMOUNT-STR) NOT = 0
              DISPLAY "AMOUNT MUST BE A NUMBER."
              STOP RUN
           END-IF

           MOVE FUNCTION NUMVAL(AMOUNT-STR) TO AMOUNT-NUM
           IF AMOUNT-NUM <= 0
              DISPLAY "AMOUNT MUST BE GREATER THAN ZERO."
              STOP RUN
           END-IF.

       SAVE-TRANSACTION.
           MOVE "N" TO EOF-FLAG FOUND-FLAG ERROR-FLAG
              INVALID-ENTRY-FLAG CLOSED-ACCOUNT-FLAG SKIP-FLAG
           OPEN INPUT ACCOUNTS-IN
           OPEN OUTPUT ACCOUNTS-OUT

           PERFORM UNTIL EOF-FLAG = "Y"
           READ ACCOUNTS-IN
           AT END
           MOVE "Y" TO EOF-FLAG
           NOT AT END
           PERFORM PROCESS-ACCOUNT
           END-READ
           END-PERFORM

           CLOSE ACCOUNTS-IN
           CLOSE ACCOUNTS-OUT

           IF FOUND-FLAG NOT = "Y"
              MOVE "rm -f data/accounts.tmp" TO SYSTEM-COMMAND
              CALL "SYSTEM" USING SYSTEM-COMMAND
              DISPLAY "ACCOUNT NOT FOUND."
              STOP RUN
           END-IF

           IF INVALID-ENTRY-FLAG = "Y"
              MOVE "rm -f data/accounts.tmp" TO SYSTEM-COMMAND
              CALL "SYSTEM" USING SYSTEM-COMMAND
              DISPLAY "ACCOUNT ENTRY IS INVALID."
              STOP RUN
           END-IF

           IF CLOSED-ACCOUNT-FLAG = "Y"
              MOVE "rm -f data/accounts.tmp" TO SYSTEM-COMMAND
              CALL "SYSTEM" USING SYSTEM-COMMAND
              DISPLAY "ACCOUNT IS CLOSED."
              STOP RUN
           END-IF

           IF ERROR-FLAG = "Y"
              MOVE "rm -f data/accounts.tmp" TO SYSTEM-COMMAND
              CALL "SYSTEM" USING SYSTEM-COMMAND
              DISPLAY "TRANSACTION FAILED. INSUFFICIENT FUNDS."
              STOP RUN
           END-IF

           MOVE "mv -f data/accounts.tmp data/accounts.dat"
              TO SYSTEM-COMMAND
           CALL "SYSTEM" USING SYSTEM-COMMAND

           OPEN EXTEND TRANSACTIONS-FILE
           ACCEPT DATE-YYYYMMDD FROM DATE YYYYMMDD
           ACCEPT TIME-HHMMSSCC FROM TIME
           MOVE SPACES TO TRANSACTIONS-RECORD
           STRING DATE-YYYYMMDD DELIMITED BY SIZE
              "-" DELIMITED BY SIZE
              TIME-HHMMSSCC(1:6) DELIMITED BY SIZE
              INTO TR-TIMESTAMP
           END-STRING
           MOVE FUNCTION TRIM(TARGET-ID) TO TR-ACCOUNT-ID
           MOVE TRANS-TYPE TO TR-TYPE
           MOVE AMOUNT-NUM TO TR-AMOUNT
           MOVE NEW-BALANCE TO TR-NEW-BALANCE
           MOVE DESCRIPTION-TEXT TO TR-DESCRIPTION

           WRITE TRANSACTIONS-RECORD
           CLOSE TRANSACTIONS-FILE

           MOVE NEW-BALANCE TO DISPLAY-BALANCE
           DISPLAY "TRANSACTION SUCCESSFUL. NEW BALANCE: $"
           FUNCTION TRIM(DISPLAY-BALANCE).

       PROCESS-ACCOUNT.
           IF AI-ACCOUNT-ID NOT = TARGET-ID
              MOVE ACCOUNTS-IN-RECORD TO ACCOUNTS-OUT-RECORD
              WRITE ACCOUNTS-OUT-RECORD
           ELSE
              MOVE "Y" TO FOUND-FLAG
              MOVE AI-ACCOUNT-ID TO ACCOUNT-ID
              MOVE AI-USER-ID TO USER-ID

              IF AI-STATUS NOT = "OPEN" AND AI-STATUS NOT = "CLOSED"
                 MOVE "Y" TO INVALID-ENTRY-FLAG
                 MOVE ACCOUNTS-IN-RECORD TO ACCOUNTS-OUT-RECORD
                 WRITE ACCOUNTS-OUT-RECORD
                 EXIT PARAGRAPH
              END-IF

              IF AI-STATUS = "CLOSED"
                 MOVE "Y" TO CLOSED-ACCOUNT-FLAG
                 MOVE ACCOUNTS-IN-RECORD TO ACCOUNTS-OUT-RECORD
                 WRITE ACCOUNTS-OUT-RECORD
                 EXIT PARAGRAPH
              END-IF

              IF AI-TYPE NOT = "CHECKING" AND AI-TYPE NOT = "SAVINGS"
                 MOVE "Y" TO INVALID-ENTRY-FLAG
                 MOVE ACCOUNTS-IN-RECORD TO ACCOUNTS-OUT-RECORD
                 WRITE ACCOUNTS-OUT-RECORD
                 EXIT PARAGRAPH
              END-IF

              PERFORM COMPUTE-NEW-BALANCE
           END-IF.

       COMPUTE-NEW-BALANCE.
           MOVE "N" TO SKIP-FLAG
           MOVE AI-BALANCE TO CURRENT-BALANCE

           IF TRANS-TYPE = "D"
              COMPUTE NEW-BALANCE = CURRENT-BALANCE + AMOUNT-NUM
           ELSE
              IF CURRENT-BALANCE < AMOUNT-NUM
                 MOVE "Y" TO ERROR-FLAG
                 MOVE "Y" TO SKIP-FLAG
              ELSE
                 COMPUTE NEW-BALANCE = CURRENT-BALANCE - AMOUNT-NUM
              END-IF
           END-IF

           IF SKIP-FLAG = "Y"
              MOVE ACCOUNTS-IN-RECORD TO ACCOUNTS-OUT-RECORD
              WRITE ACCOUNTS-OUT-RECORD
           ELSE
              MOVE SPACES TO ACCOUNTS-OUT-RECORD
              MOVE ACCOUNT-ID TO AO-ACCOUNT-ID
              MOVE USER-ID TO AO-USER-ID
              MOVE NEW-BALANCE TO AO-BALANCE
              MOVE AI-STATUS TO AO-STATUS
              MOVE AI-TYPE TO AO-TYPE
              WRITE ACCOUNTS-OUT-RECORD
           END-IF.
