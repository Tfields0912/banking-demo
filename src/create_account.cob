       IDENTIFICATION DIVISION.
       PROGRAM-ID. CREATE-ACCOUNT.

       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT USERS-FILE ASSIGN TO "data/users.dat"
           ORGANIZATION IS LINE SEQUENTIAL.
           SELECT ACCOUNTS-IN ASSIGN TO "data/accounts.dat"
           ORGANIZATION IS LINE SEQUENTIAL.
           SELECT ACCOUNTS-OUT ASSIGN TO "data/accounts.tmp"
           ORGANIZATION IS LINE SEQUENTIAL.

       DATA DIVISION.
       FILE SECTION.
       FD USERS-FILE.
       01 USERS-RECORD PIC X(200).

       FD ACCOUNTS-IN.
       01 ACCOUNTS-IN-RECORD PIC X(120).

       FD ACCOUNTS-OUT.
       01 ACCOUNTS-OUT-RECORD PIC X(120).

       WORKING-STORAGE SECTION.
       01 USERS-EOF-FLAG PIC X VALUE "N".
       01 ACCOUNTS-EOF-FLAG PIC X VALUE "N".
       01 USER-FOUND-FLAG PIC X VALUE "N".
       01 EXISTS-FLAG PIC X VALUE "N".

       01 NEW-USER-ID PIC X(10).
       01 NEW-ID PIC X(10).
       01 NEW-TYPE PIC X(10).
       01 OPENING-BALANCE-STR PIC X(20).
       01 OPENING-BALANCE-NUM PIC S9(9)V99 VALUE 0.
       01 OPENING-BALANCE-OUT PIC Z(9)9.99.

       01 ACCOUNT-ID PIC X(10).
       01 USER-ID PIC X(10).

       01 SYSTEM-COMMAND PIC X(200).

       PROCEDURE DIVISION.
       MAIN.
           DISPLAY "CREATE ACCOUNT"
           DISPLAY "--------------"
           PERFORM GET-INPUT
           PERFORM VALIDATE-INPUT
           PERFORM SAVE-ACCOUNT
           STOP RUN.

       GET-INPUT.
           DISPLAY "ENTER EXISTING USER ID: " WITH NO ADVANCING
           ACCEPT NEW-USER-ID
           MOVE FUNCTION TRIM(NEW-USER-ID) TO NEW-USER-ID

           DISPLAY "ENTER NEW ACCOUNT ID: " WITH NO ADVANCING
           ACCEPT NEW-ID
           MOVE FUNCTION TRIM(NEW-ID) TO NEW-ID

           DISPLAY "ENTER ACCOUNT TYPE (C/S): " WITH NO ADVANCING
           ACCEPT NEW-TYPE
           MOVE FUNCTION TRIM(NEW-TYPE) TO NEW-TYPE
           MOVE FUNCTION UPPER-CASE(NEW-TYPE) TO NEW-TYPE

           IF NEW-TYPE = "C"
           MOVE "CHECKING" TO NEW-TYPE
           END-IF
           IF NEW-TYPE = "S"
           MOVE "SAVINGS" TO NEW-TYPE
           END-IF

           DISPLAY "ENTER OPENING BALANCE: " WITH NO ADVANCING
           ACCEPT OPENING-BALANCE-STR
           MOVE FUNCTION TRIM(OPENING-BALANCE-STR)
           TO OPENING-BALANCE-STR.

       VALIDATE-INPUT.
           IF NEW-USER-ID = SPACES
           DISPLAY "USER ID IS REQUIRED."
           STOP RUN
           END-IF

           IF NEW-ID = SPACES
           DISPLAY "ACCOUNT ID IS REQUIRED."
           STOP RUN
           END-IF

           IF NEW-TYPE NOT = "CHECKING" AND NEW-TYPE NOT = "SAVINGS"
           DISPLAY "ACCOUNT TYPE MUST BE CHECKING OR SAVINGS (C/S)."
           STOP RUN
           END-IF

           IF OPENING-BALANCE-STR = SPACES
           DISPLAY "OPENING BALANCE IS REQUIRED."
           STOP RUN
           END-IF

           IF FUNCTION TEST-NUMVAL(OPENING-BALANCE-STR) NOT = 0
           DISPLAY "OPENING BALANCE MUST BE A VALID NUMBER."
           STOP RUN
           END-IF
           MOVE FUNCTION NUMVAL(OPENING-BALANCE-STR)
           TO OPENING-BALANCE-NUM
           IF OPENING-BALANCE-NUM < 0
           DISPLAY "OPENING BALANCE CANNOT BE NEGATIVE."
           STOP RUN
           END-IF

           PERFORM CHECK-USER-EXISTS
           IF USER-FOUND-FLAG NOT = "Y"
           DISPLAY "USER ID NOT FOUND. CREATE USER FIRST."
           STOP RUN
           END-IF.

       SAVE-ACCOUNT.
           MOVE "N" TO ACCOUNTS-EOF-FLAG EXISTS-FLAG
           OPEN INPUT ACCOUNTS-IN
           OPEN OUTPUT ACCOUNTS-OUT

           PERFORM UNTIL ACCOUNTS-EOF-FLAG = "Y"
           READ ACCOUNTS-IN
           AT END
           MOVE "Y" TO ACCOUNTS-EOF-FLAG
           NOT AT END
           MOVE ACCOUNTS-IN-RECORD TO ACCOUNTS-OUT-RECORD
           WRITE ACCOUNTS-OUT-RECORD
           PERFORM CHECK-ACCOUNT-ID
           END-READ
           END-PERFORM

           IF EXISTS-FLAG = "Y"
           CLOSE ACCOUNTS-IN
           CLOSE ACCOUNTS-OUT
           MOVE "rm -f data/accounts.tmp" TO SYSTEM-COMMAND
           CALL "SYSTEM" USING SYSTEM-COMMAND
           DISPLAY "ACCOUNT ID ALREADY EXISTS."
           STOP RUN
           END-IF

           MOVE OPENING-BALANCE-NUM TO OPENING-BALANCE-OUT
           MOVE SPACES TO ACCOUNTS-OUT-RECORD
           STRING
           NEW-ID DELIMITED BY SIZE
           "," DELIMITED BY SIZE
           NEW-USER-ID DELIMITED BY SIZE
           "," DELIMITED BY SIZE
           FUNCTION TRIM(OPENING-BALANCE-OUT) DELIMITED BY SIZE
           "," DELIMITED BY SIZE
           "OPEN" DELIMITED BY SIZE
           "," DELIMITED BY SIZE
           NEW-TYPE DELIMITED BY SIZE
           INTO ACCOUNTS-OUT-RECORD
           END-STRING
           WRITE ACCOUNTS-OUT-RECORD

           CLOSE ACCOUNTS-IN
           CLOSE ACCOUNTS-OUT

           MOVE "mv -f data/accounts.tmp data/accounts.dat"
           TO SYSTEM-COMMAND
           CALL "SYSTEM" USING SYSTEM-COMMAND

           DISPLAY "BANK ACCOUNT CREATED.".

       CHECK-USER-EXISTS.
           MOVE "N" TO USERS-EOF-FLAG USER-FOUND-FLAG
           OPEN INPUT USERS-FILE

           PERFORM UNTIL USERS-EOF-FLAG = "Y"
           READ USERS-FILE
           AT END
           MOVE "Y" TO USERS-EOF-FLAG
           NOT AT END
           MOVE SPACES TO USER-ID
           UNSTRING USERS-RECORD DELIMITED BY ","
           INTO USER-ID
           END-UNSTRING
           IF FUNCTION TRIM(USER-ID) = FUNCTION TRIM(NEW-USER-ID)
           MOVE "Y" TO USER-FOUND-FLAG
           MOVE "Y" TO USERS-EOF-FLAG
           END-IF
           END-READ
           END-PERFORM

           CLOSE USERS-FILE.

       CHECK-ACCOUNT-ID.
           MOVE SPACES TO ACCOUNT-ID
           UNSTRING ACCOUNTS-IN-RECORD DELIMITED BY ","
           INTO ACCOUNT-ID
           END-UNSTRING

           IF FUNCTION TRIM(ACCOUNT-ID) = FUNCTION TRIM(NEW-ID)
           MOVE "Y" TO EXISTS-FLAG
           END-IF.
