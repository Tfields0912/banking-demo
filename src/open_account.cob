       IDENTIFICATION DIVISION.
       PROGRAM-ID. OPEN-ACCOUNT.

       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT USERS-FILE ASSIGN TO "data/users.dat"
              ORGANIZATION IS LINE SEQUENTIAL.
           SELECT ACCOUNTS-IN ASSIGN TO "data/accounts.dat"
              ORGANIZATION IS LINE SEQUENTIAL.
           SELECT ACCOUNTS-OUT ASSIGN TO "data/accounts.tmp"
              ORGANIZATION IS LINE SEQUENTIAL.
           SELECT TRANSACTIONS-FILE ASSIGN TO "data/transactions.dat"
              ORGANIZATION IS LINE SEQUENTIAL.

       DATA DIVISION.
       FILE SECTION.
       FD USERS-FILE.
       01 USERS-RECORD.
           05 UR-USER-ID    PIC X(10).
           05 UR-NAME       PIC X(40).
           05 UR-ADDRESS    PIC X(80).
           05 UR-CITY       PIC X(40).
           05 UR-STATE      PIC X(2).
           05 UR-ZIPCODE    PIC X(5).
           05 UR-DOB        PIC X(10).
           05 UR-PHONE      PIC X(12).
           05 UR-PAD        PIC X(1).

       FD ACCOUNTS-IN.
       01 ACCOUNTS-IN-RECORD.
           05 AI-ACCOUNT-ID  PIC X(10).
           05 AI-USER-ID     PIC X(10).
           05 AI-BALANCE     PIC 9(9)V99.
           05 AI-STATUS      PIC X(8).
           05 AI-TYPE        PIC X(8).
           05 AI-PAD         PIC X(3).

       FD ACCOUNTS-OUT.
       01 ACCOUNTS-OUT-RECORD.
           05 AO-ACCOUNT-ID  PIC X(10).
           05 AO-USER-ID     PIC X(10).
           05 AO-BALANCE     PIC 9(9)V99.
           05 AO-STATUS      PIC X(8).
           05 AO-TYPE        PIC X(8).
           05 AO-PAD         PIC X(3).

       FD TRANSACTIONS-FILE.
       01 TRANSACTIONS-RECORD.
           05 TR-TIMESTAMP    PIC X(15).
           05 TR-ACCOUNT-ID   PIC X(10).
           05 TR-TYPE         PIC X(1).
           05 TR-AMOUNT       PIC 9(9)V99.
           05 TR-NEW-BALANCE  PIC 9(9)V99.
           05 TR-DESCRIPTION  PIC X(40).
           05 TR-PAD          PIC X(12).

       WORKING-STORAGE SECTION.
       01 CONTROL-FLAGS.
           05 USERS-EOF-FLAG PIC X VALUE "N".
           05 ACCOUNTS-EOF-FLAG PIC X VALUE "N".
           05 USER-FOUND-FLAG PIC X VALUE "N".
           05 ACCOUNT-EXISTS-FLAG PIC X VALUE "N".

       01 INPUT-FIELDS.
           05 NEW-USER-ID PIC X(10).
           05 NEW-ID PIC X(10).
           05 NEW-TYPE PIC X(10).
           05 OPENING-BALANCE-STR PIC X(20).
           05 OPENING-BALANCE-NUM PIC S9(9)V99 VALUE 0.
           05 OPENING-BALANCE-OUT PIC Z(9)9.99.

       01 RECORD-FIELDS.
           05 ACCOUNT-ID PIC X(10).
           05 USER-ID PIC X(10).

       01 WORK-FIELDS.
           05 DATE-YYYYMMDD PIC X(8).
           05 TIME-HHMMSSCC PIC X(8).
           05 CREATE-TRANS-DESC PIC X(40).
           05 CREATE-TRANS-TYPE PIC X.

       01 SYSTEM-FIELDS.
           05 SYSTEM-COMMAND PIC X(200).

       PROCEDURE DIVISION.
       MAIN.
           DISPLAY "OPEN ACCOUNT"
           DISPLAY "------------"
           PERFORM GET-INPUT
           PERFORM VALIDATE-INPUT
           PERFORM SAVE-ACCOUNT
           STOP RUN.

       GET-INPUT.
           DISPLAY "ENTER EXISTING USER ID: " WITH NO ADVANCING
           ACCEPT NEW-USER-ID
           MOVE FUNCTION TRIM(NEW-USER-ID) TO NEW-USER-ID

           DISPLAY "ENTER NEW ACCOUNT ID: " WITH NO ADVANCING
           ACCEPT NEW-ID
           MOVE FUNCTION TRIM(NEW-ID) TO NEW-ID

           DISPLAY "ENTER ACCOUNT TYPE (C/S): " WITH NO ADVANCING
           ACCEPT NEW-TYPE
           MOVE FUNCTION TRIM(NEW-TYPE) TO NEW-TYPE
           MOVE FUNCTION UPPER-CASE(NEW-TYPE) TO NEW-TYPE

           IF NEW-TYPE = "C"
              MOVE "CHECKING" TO NEW-TYPE
           END-IF
           IF NEW-TYPE = "S"
              MOVE "SAVINGS" TO NEW-TYPE
           END-IF

           DISPLAY "ENTER OPENING BALANCE (MIN $5.00): "
              WITH NO ADVANCING
           ACCEPT OPENING-BALANCE-STR
           MOVE FUNCTION TRIM(OPENING-BALANCE-STR)
              TO OPENING-BALANCE-STR.

       VALIDATE-INPUT.
           IF NEW-USER-ID = SPACES
              DISPLAY "USER ID IS REQUIRED."
              STOP RUN
           END-IF

           IF NEW-ID = SPACES
              DISPLAY "ACCOUNT ID IS REQUIRED."
              STOP RUN
           END-IF

           IF NEW-TYPE NOT = "CHECKING" AND NEW-TYPE NOT = "SAVINGS"
              DISPLAY "ACCOUNT TYPE MUST BE CHECKING OR SAVINGS (C/S)."
              STOP RUN
           END-IF

           IF OPENING-BALANCE-STR = SPACES
              DISPLAY "OPENING BALANCE IS REQUIRED."
              STOP RUN
           END-IF

           IF FUNCTION TEST-NUMVAL(OPENING-BALANCE-STR) NOT = 0
              DISPLAY "OPENING BALANCE MUST BE A VALID NUMBER."
              STOP RUN
           END-IF
           
           MOVE FUNCTION NUMVAL(OPENING-BALANCE-STR)
              TO OPENING-BALANCE-NUM
           IF OPENING-BALANCE-NUM < 5
              DISPLAY "OPENING BALANCE MUST BE AT LEAST $5.00."
              STOP RUN
           END-IF

           PERFORM CHECK-USER-EXISTS
           IF USER-FOUND-FLAG NOT = "Y"
              DISPLAY "USER ID NOT FOUND. CREATE USER FIRST."
              STOP RUN
           END-IF.

       SAVE-ACCOUNT.
           MOVE "N" TO ACCOUNTS-EOF-FLAG ACCOUNT-EXISTS-FLAG
           OPEN INPUT ACCOUNTS-IN
           OPEN OUTPUT ACCOUNTS-OUT

           PERFORM UNTIL ACCOUNTS-EOF-FLAG = "Y"
           READ ACCOUNTS-IN
           AT END
           MOVE "Y" TO ACCOUNTS-EOF-FLAG
           NOT AT END
           MOVE ACCOUNTS-IN-RECORD TO ACCOUNTS-OUT-RECORD
           WRITE ACCOUNTS-OUT-RECORD
           PERFORM CHECK-ACCOUNT-ID
           END-READ
           END-PERFORM

           IF ACCOUNT-EXISTS-FLAG = "Y"
              CLOSE ACCOUNTS-IN
              CLOSE ACCOUNTS-OUT
              MOVE "rm -f data/accounts.tmp" TO SYSTEM-COMMAND
              CALL "SYSTEM" USING SYSTEM-COMMAND
              DISPLAY "ACCOUNT ID ALREADY EXISTS."
              STOP RUN
           END-IF

           MOVE SPACES TO ACCOUNTS-OUT-RECORD
           MOVE NEW-ID TO AO-ACCOUNT-ID
           MOVE NEW-USER-ID TO AO-USER-ID
           MOVE OPENING-BALANCE-NUM TO AO-BALANCE
           MOVE "OPEN" TO AO-STATUS
           MOVE NEW-TYPE TO AO-TYPE
           WRITE ACCOUNTS-OUT-RECORD

           CLOSE ACCOUNTS-IN
           CLOSE ACCOUNTS-OUT

           MOVE "mv -f data/accounts.tmp data/accounts.dat"
              TO SYSTEM-COMMAND
           CALL "SYSTEM" USING SYSTEM-COMMAND

           OPEN EXTEND TRANSACTIONS-FILE
           ACCEPT DATE-YYYYMMDD FROM DATE YYYYMMDD
           ACCEPT TIME-HHMMSSCC FROM TIME

           MOVE "O" TO CREATE-TRANS-TYPE
           MOVE "ACCOUNT OPENED - INITIAL DEPOSIT"
              TO CREATE-TRANS-DESC

           DISPLAY "ACCOUNT OPENED."

           MOVE SPACES TO TRANSACTIONS-RECORD
           STRING
           DATE-YYYYMMDD DELIMITED BY SIZE
           "-" DELIMITED BY SIZE
           TIME-HHMMSSCC(1:6) DELIMITED BY SIZE
           INTO TR-TIMESTAMP
           END-STRING
           MOVE NEW-ID TO TR-ACCOUNT-ID
           MOVE CREATE-TRANS-TYPE TO TR-TYPE
           MOVE OPENING-BALANCE-NUM TO TR-AMOUNT
           MOVE OPENING-BALANCE-NUM TO TR-NEW-BALANCE
           MOVE CREATE-TRANS-DESC TO TR-DESCRIPTION
           WRITE TRANSACTIONS-RECORD
           CLOSE TRANSACTIONS-FILE.

       CHECK-USER-EXISTS.
           MOVE "N" TO USERS-EOF-FLAG USER-FOUND-FLAG
           OPEN INPUT USERS-FILE

           PERFORM UNTIL USERS-EOF-FLAG = "Y"
           READ USERS-FILE
           AT END
           MOVE "Y" TO USERS-EOF-FLAG
           NOT AT END
           IF UR-USER-ID = NEW-USER-ID
              MOVE "Y" TO USER-FOUND-FLAG
              MOVE "Y" TO USERS-EOF-FLAG
           END-IF
           END-READ
           END-PERFORM

           CLOSE USERS-FILE.

       CHECK-ACCOUNT-ID.
           IF AI-ACCOUNT-ID = NEW-ID
              MOVE "Y" TO ACCOUNT-EXISTS-FLAG
           END-IF.
